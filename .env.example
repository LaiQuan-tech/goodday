# ===== web(Vercel)=====
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://goodday.vercel.app

# Resend(email 通知;未設定則靜默停用)
RESEND_API_KEY=
RESEND_FROM=好日子 Good Days <onboarding@resend.dev>
CONTACT_NOTIFY_TO=admin@example.com

# Gemini(AI 客服/報價;未設定則退化為規則式回覆,流程仍可運作)
GEMINI_API_KEY=
# GEMINI_MODEL=gemma-4-31b-it

# PayUni 統一金流(信用卡;四個值都設定才會在結帳頁顯示刷卡選項)
PAYUNI_MER_ID=
# HashKey 固定 32 字元、HashIV 固定 16 字元,原字串直接當 AES-256-GCM 的 key/iv,
# 前後不要有多餘空白(程式會 trim,但貼錯長度會直接 throw)。
PAYUNI_HASH_KEY=
PAYUNI_HASH_IV=
# ⚠️ 只有明確填 "false" 才會打正式環境;未設定/空白/其他任何值一律走沙盒。
# 這與舊金流商的 SANDBOX 變數方向相反,是刻意的:「該正式卻走沙盒」只是收不到錢、
# 可以補救;「該沙盒卻走正式」是測試時真的刷客人的卡,只能退刷。預設選安全的那邊。
PAYUNI_SANDBOX=true
# webhook 密鑰:NotifyURL 會附上 ?k=<此值>,webhook route 用它擋掉偽造 POST(未設定時
# 連 NotifyURL 都不會帶給 PayUni,等於收不到付款通知,所以刷卡選項會整個隱藏)。
# 請自行產生一組高熵亂數字串(如 openssl rand -hex 32),不要用短字串或可猜測的值。
PAYUNI_WEBHOOK_SECRET=

# Sentry 錯誤追蹤(web;未設定則整個停用,不會影響任何功能)
# ⚠️ NEXT_PUBLIC_ 開頭的變數會被打進瀏覽器 bundle,只能放公開的 DSN。
#    Sentry DSN 本來就是公開值(只能寫入、不能讀取),放 client 是官方做法。
NEXT_PUBLIC_SENTRY_DSN=
# server / edge runtime 用的 DSN(可與上面同一個值)。這個沒有 NEXT_PUBLIC_ 前綴,
# 不會進 client bundle;server 端專用的機密一律不准加該前綴。
SENTRY_DSN=
# 以下三個只在 Vercel build 期使用(上傳 source map,才看得到原始碼行號)。
# ⚠️ SENTRY_AUTH_TOKEN 是真正的機密,只能設在 Vercel 環境變數,不要進 repo。
#    未設定時只是不上傳 source map,build 仍會成功。
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ===== api(Railway)=====
SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=(同上)
# RESEND_API_KEY=(同上)
SITE_URL=https://goodday.vercel.app
JOB_SECRET=
QUOTE_FOLLOWUP_DAYS=3
TZ=Asia/Taipei
# Sentry 錯誤追蹤(api;未設定則停用)。與 web 可用同一個專案或分開兩個。
# 排程的 Cron Monitor(slug: goodday-followup-jobs)也靠這個 DSN 送 check-in,
# 沒設定的話「排程漏跑」就只剩行程內 watchdog,程序整個死掉時不會有人知道。
# SENTRY_DSN=(與 web 同名,Railway 這側自行設定)
#
# 告警信(排程失敗、線上錯誤)沿用既有 Resend,不需要新的憑證或服務。
# api 這側要能寄告警信,以下三個必須也設在 Railway(值與 web 那側相同):
#   RESEND_API_KEY    寄信憑證;未設定 → 告警通道停用,只留 log,不影響排程運作
#   RESEND_FROM       寄件者;未設定則用預設的 onboarding@resend.dev
#   CONTACT_NOTIFY_TO 告警收件人;未設定 → 同上,告警通道停用
# (原本規劃的 LINE Notify 已移除:該服務已於 2025-03-31 正式終止,端點是死的。)
# RESEND_API_KEY=(同上)
# RESEND_FROM=(同上)
# CONTACT_NOTIFY_TO=(同上)

# ===== 一鍵佈建 scripts/provision.mjs 用 =====
SUPABASE_ACCESS_TOKEN=sbp_xxx
VERCEL_TOKEN=
RAILWAY_TOKEN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# SUPABASE_ORG_ID=
# GITHUB_REPO=LaiQuan-tech/goodday
# PROJECT_NAME=goodday
