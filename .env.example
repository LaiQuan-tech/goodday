# ===== web(Vercel)=====
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://goodday.vercel.app

# Resend(email 通知;未設定則靜默停用)
RESEND_API_KEY=
RESEND_FROM=好日子 Good Days <onboarding@resend.dev>
CONTACT_NOTIFY_TO=admin@example.com

# Gemini(AI 客服/報價;未設定則退化為規則式回覆,流程仍可運作)
GEMINI_API_KEY=
# GEMINI_MODEL=gemma-4-31b-it

# PayUni 統一金流(信用卡;四個值都設定才會在結帳頁顯示刷卡選項)
PAYUNI_MER_ID=
# HashKey 固定 32 字元、HashIV 固定 16 字元,原字串直接當 AES-256-GCM 的 key/iv,
# 前後不要有多餘空白(程式會 trim,但貼錯長度會直接 throw)。
PAYUNI_HASH_KEY=
PAYUNI_HASH_IV=
# ⚠️ 只有明確填 "false" 才會打正式環境;未設定/空白/其他任何值一律走沙盒。
# 這與舊金流商的 SANDBOX 變數方向相反,是刻意的:「該正式卻走沙盒」只是收不到錢、
# 可以補救;「該沙盒卻走正式」是測試時真的刷客人的卡,只能退刷。預設選安全的那邊。
PAYUNI_SANDBOX=true
# webhook 密鑰:NotifyURL 會附上 ?k=<此值>,webhook route 用它擋掉偽造 POST(未設定時
# 連 NotifyURL 都不會帶給 PayUni,等於收不到付款通知,所以刷卡選項會整個隱藏)。
# 請自行產生一組高熵亂數字串(如 openssl rand -hex 32),不要用短字串或可猜測的值。
PAYUNI_WEBHOOK_SECRET=

# ===== api(Railway)=====
SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=(同上)
# RESEND_API_KEY=(同上)
SITE_URL=https://goodday.vercel.app
JOB_SECRET=
QUOTE_FOLLOWUP_DAYS=3
TZ=Asia/Taipei

# ===== 一鍵佈建 scripts/provision.mjs 用 =====
SUPABASE_ACCESS_TOKEN=sbp_xxx
VERCEL_TOKEN=
RAILWAY_TOKEN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
